{
  "name": "detection-lab-web",
  "private": true,
  "version": "0.0.0",
  "description": "The detection lab's web preview, served at /lab/ on hubertjablon.ski",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "diagram": "node scripts/diagram.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
